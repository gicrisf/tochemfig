(ert-deftest chem-svg-reaction-layout-parity ()
  "Native layout follows SmilesDrawer's composition rules."
  (dolist (entry (chem-svg-reaction-parity-test--list
                  (chem-svg-reaction-parity-test--get
                   (chem-svg-reaction-parity-test--manifest) "fixtures")))
    (let ((name (chem-svg-reaction-parity-test--get entry "name")))
      (ert-info ((format "fixture: %s" name))
        (chem-svg-reaction-parity-test--check-layout-parity
         (chem-svg-reaction-parity-test--load name))))))

(ert-deftest chem-svg-reaction-parity-fixture-metadata ()
  "Reaction fixtures and manifest entries stay in sync."
  (let ((names nil))
    (dolist (entry (chem-svg-reaction-parity-test--list
                    (chem-svg-reaction-parity-test--get
                     (chem-svg-reaction-parity-test--manifest) "fixtures")))
      (let* ((name (chem-svg-reaction-parity-test--get entry "name"))
             (fixture (chem-svg-reaction-parity-test--load name)))
        (push name names)
        (should (equal name (chem-svg-reaction-parity-test--get fixture "name")))
        (should (stringp (chem-svg-reaction-parity-test--get fixture "smiles")))
        (should (equal (chem-svg-reaction-parity-test--get entry "features")
                       (chem-svg-reaction-parity-test--get fixture "features")))
        (should (eq (chem-svg-reaction-parity-test--get entry "raster")
                    (chem-svg-reaction-parity-test--get fixture "raster")))
        (should (chem-svg-reaction-parity-test--get fixture "reference"))
        (should (> (length (chem-svg-reaction-parity-test--list
                            (chem-svg-reaction-parity-test--get
                             fixture "components")))
                   0))
        (should (cl-find-if
                 (lambda (part)
                   (equal (chem-svg-reaction-parity-test--get part "kind")
                          "arrow"))
                 (chem-svg-reaction-parity-test--list
                  (chem-svg-reaction-parity-test--get fixture "flow"))))))
    (should (= (length names) (length (delete-dups (copy-sequence names)))))))

