;;; Commentary:

;; Fast composition parity checks for reaction SVG rendering.  The fixtures
;; are generated by `tools/smilesdrawer/render-reactions.mjs'.  They contain
;; SmilesDrawer's post-layout component graphs and the reaction composition
;; (component placement, plus signs, arrow, and text boxes).
;;
;; Component primitives and labels are intentionally not compared here; those
;; are covered by the molecule parity suite.  Reaction raster gates are kept
;; separate and remain advisory until this fast suite is stable.

;;; Code:

(require 'ert)
(require 'cl-lib)
(require 'json)
(require 'chem-mode)
(require 'chem-exp-svg)

(defconst chem-svg-reaction-parity-test--root
  (file-name-directory (or load-file-name buffer-file-name))
  "Directory containing the reaction parity fixtures.")

(defconst chem-svg-reaction-parity-test--fixture-dir
  (expand-file-name "fixtures/smilesdrawer-reactions"
                    chem-svg-reaction-parity-test--root)
  "Directory containing generated SmilesDrawer reaction fixtures.")

(defconst chem-svg-reaction-parity-test--tolerance 1.0
  "Maximum coordinate difference for composition parity.")

(defconst chem-svg-reaction-parity-test--viewbox-tolerance 3.0
  "Maximum viewBox difference for composition parity.")

(defconst chem-svg-reaction-parity-test--layout-scale 30.0
  "SVG units per IR unit for layout parity.")

(defun chem-svg-reaction-parity-test--manifest ()
  "Return the reaction fixture manifest."
  (with-temp-buffer
    (insert-file-contents (expand-file-name "manifest.json"
                                            chem-svg-reaction-parity-test--fixture-dir))
    (json-parse-string (buffer-string) :object-type 'alist)))

(defun chem-svg-reaction-parity-test--load (name)
  "Load reaction fixture NAME."
  (with-temp-buffer
    (insert-file-contents (expand-file-name (concat name ".json")
                                            chem-svg-reaction-parity-test--fixture-dir))
    (json-parse-string (buffer-string) :object-type 'alist)))

(defun chem-svg-reaction-parity-test--get (alist key)
  "Return KEY from ALIST, accepting string or symbol keys."
  (or (alist-get (intern key) alist nil nil #'eq)
      (alist-get key alist nil nil #'equal)))

(defun chem-svg-reaction-parity-test--list (value)
  "Return VALUE as a list."
  (append value nil))

(defun chem-svg-reaction-parity-test--number (value)
  "Return VALUE as a number."
  (cond ((numberp value) value)
        ((stringp value) (string-to-number value))
        (t 0.0)))

(defun chem-svg-reaction-parity-test--atom-angle (atoms from to)
  "Return the IR angle from atom FROM to atom TO in ATOMS."
  (let* ((a (gethash from atoms))
         (b (gethash to atoms))
         (radians (atan (- (chem-atom-y b) (chem-atom-y a))
                        (- (chem-atom-x b) (chem-atom-x a)))))
    (mod (* radians (/ 180.0 float-pi)) 360.0)))

(defun chem-svg-reaction-parity-test--bond-order (order)
  "Map SmilesDrawer ORDER to an IR bond order."
  (pcase order
    ("single" :single)
    ("double" :double)
    ("triple" :triple)
    ("aromatic" :aromatic)
    (_ :single)))

(defun chem-svg-reaction-parity-test--bond-stereo (stereo)
  "Map SmilesDrawer STEREO to an IR bond stereo."
  (pcase stereo
    ("up" :up)
    ("down" :down)
    (_ :none)))

(defun chem-svg-reaction-parity-test--fixture-atom (atoms id)
  "Return the atom JSON with ID from ATOMS."
  (cl-find-if
   (lambda (atom)
     (equal (chem-svg-reaction-parity-test--number
             (chem-svg-reaction-parity-test--get atom "id"))
            id))
   atoms))

(defun chem-svg-reaction-parity-test--build-drawing (component &optional scale)
  "Build a test-only `chem-drawing' from reaction COMPONENT.
SmilesDrawer uses SVG-style y-down coordinates; the IR uses y-up.
SCALE converts the reference coordinate units to IR units."
  (let* ((scale (or scale 1.0))
         (atoms-json (chem-svg-reaction-parity-test--list
                      (chem-svg-reaction-parity-test--get component "atoms")))
         (edges-json (chem-svg-reaction-parity-test--list
                      (chem-svg-reaction-parity-test--get component "edges")))
         (rings-json (chem-svg-reaction-parity-test--list
                      (chem-svg-reaction-parity-test--get component "rings")))
         (atoms (make-hash-table :test 'eql))
         (edges (make-hash-table :test 'eql))
         (edge-lookup (make-hash-table :test 'equal))
         (adjacency (make-hash-table :test 'eql)))
    (dolist (json atoms-json)
      (let* ((idx (chem-svg-reaction-parity-test--number
                   (chem-svg-reaction-parity-test--get json "id")))
             (element (chem-svg-reaction-parity-test--get json "element"))
             (hydrogens (chem-svg-reaction-parity-test--number
                         (chem-svg-reaction-parity-test--get json "hydrogens")))
             (charge (chem-svg-reaction-parity-test--number
                      (chem-svg-reaction-parity-test--get json "charge")))
             (neighbours (chem-svg-reaction-parity-test--list
                          (chem-svg-reaction-parity-test--get json "neighbours")))
             (atom (chem-atom-create
                    :idx idx
                    :x (/ (chem-svg-reaction-parity-test--number
                           (chem-svg-reaction-parity-test--get json "x"))
                          scale)
                    :y (- (/ (chem-svg-reaction-parity-test--number
                              (chem-svg-reaction-parity-test--get json "y"))
                             scale))
                    :element element
                    :hydrogens hydrogens
                    :charge charge
                    :radical 0
                    :neighbors (mapcar #'chem-svg-reaction-parity-test--number
                                       neighbours)
                    :bond-angles nil
                    :label (if (equal element "C") nil element)
                    :number nil
                    :marker nil
                    :stereocenter nil
                    :allene nil)))
        (puthash idx atom atoms)))
    (maphash
     (lambda (_ atom)
       (setf (chem-atom-bond-angles atom)
             (mapcar (lambda (neighbor)
                       (chem-svg-reaction-parity-test--atom-angle
                        atoms (chem-atom-idx atom) neighbor))
                     (chem-atom-neighbors atom))))
     atoms)
    (dolist (json edges-json)
      (let* ((id (chem-svg-reaction-parity-test--number
                  (chem-svg-reaction-parity-test--get json "id")))
             (source (chem-svg-reaction-parity-test--number
                      (chem-svg-reaction-parity-test--get json "a")))
             (target (chem-svg-reaction-parity-test--number
                      (chem-svg-reaction-parity-test--get json "b")))
             (order (chem-svg-reaction-parity-test--bond-order
                     (chem-svg-reaction-parity-test--get json "order")))
             (raw-stereo (chem-svg-reaction-parity-test--bond-stereo
                          (chem-svg-reaction-parity-test--get json "stereo")))
             (source-json (chem-svg-reaction-parity-test--fixture-atom atoms-json source))
             (target-json (chem-svg-reaction-parity-test--fixture-atom atoms-json target))
             (source-center (eq t (chem-svg-reaction-parity-test--get
                                   source-json "stereocenter")))
             (target-center (eq t (chem-svg-reaction-parity-test--get
                                   target-json "stereocenter")))
             (wedge-end (cond ((and source-center (not target-center)) target)
                              ((and target-center (not source-center)) source)
                              (t source)))
             (stereo (if (and (memq raw-stereo '(:up :down))
                              (= wedge-end target))
                         (if (eq raw-stereo :up) :down :up)
                       raw-stereo))
             (edge (chem-edge-create
                    :id id :a source :b target
                    :order order
                    :stereo stereo
                    :stereo-center (when (memq stereo '(:up :down)) wedge-end)
                    :link-p nil
                    :cross-p nil
                    :marker ""
                    :decoration 'plain)))
        (puthash id edge edges)
        (puthash (cons (min source target) (max source target))
                 edge edge-lookup)))
    (maphash
     (lambda (idx atom)
       (puthash idx
                (mapcar (lambda (neighbor)
                          (cons (chem-edge-id
                                 (gethash (cons (min idx neighbor)
                                                (max idx neighbor))
                                          edge-lookup))
                                neighbor))
                        (chem-atom-neighbors atom))
                adjacency))
     atoms)
    (let ((rings nil))
      (dolist (json rings-json)
        (let* ((id (chem-svg-reaction-parity-test--number
                    (chem-svg-reaction-parity-test--get json "id")))
               (members (mapcar #'chem-svg-reaction-parity-test--number
                                (chem-svg-reaction-parity-test--list
                                 (chem-svg-reaction-parity-test--get json "atoms"))))
               (bonds
                (cl-loop for tail on members
                         for from = (car tail)
                         for to = (or (cadr tail) (car members))
                         collect (chem-edge-id
                                  (gethash (cons (min from to) (max from to))
                                           edge-lookup)))))
          (push (chem-ring-create
                 :id id
                 :atoms members
                 :bonds bonds
                 :anchor (car bonds)
                 :aromatic-p (eq t (chem-svg-reaction-parity-test--get
                                    json "aromatic"))
                 :sequence id)
                rings)))
      (chem-drawing-create
       :atoms atoms
       :edges edges
       :edge-lookup edge-lookup
       :adjacency adjacency
       :rings (nreverse rings)
       :entry-atom (when (> (hash-table-count atoms) 0)
                     (gethash 0 atoms))
       :exit-atom nil
       :exit-node nil
       :root nil))))

(defun chem-svg-reaction-parity-test--options ()
  "Return reaction renderer options matching SmilesDrawer's coordinate units."
  (chem--build-reaction-options
   '(("svg-scale" . 1.0)
     ("svg-padding" . 10.0)
     ("svg-width" . nil)
     ("svg-height" . nil)
     ("svg-font-size" . 11.0)
     ("svg-bond-spacing" . 5.1)
     ("svg-bond-thickness" . 1.0)
     ("svg-short-bond-length" . 0.8)
     ("svg-theme" . light)
     ("svg-aromatic" . circle)
     ("svg-show-stereo" . t))
   'svg))

(defun chem-svg-reaction-parity-test--flow-part (fixture index)
  "Return the flow part for component INDEX in FIXTURE."
  (cl-find-if
   (lambda (part)
     (equal (chem-svg-reaction-parity-test--number
             (chem-svg-reaction-parity-test--get part "component"))
            index))
   (chem-svg-reaction-parity-test--list
    (chem-svg-reaction-parity-test--get fixture "flow"))))

(defun chem-svg-reaction-parity-test--text-parts (text)
  "Return layout text parts for reference TEXT.
Multi-line reference text is split into one part per line."
  (let* ((role (chem-svg-reaction-parity-test--get text "role"))
         (lines (chem-svg-reaction-parity-test--list
                 (or (chem-svg-reaction-parity-test--get text "lines")
                     (list (chem-svg-reaction-parity-test--get text "text")))))
         (x (chem-svg-reaction-parity-test--number
             (chem-svg-reaction-parity-test--get text "x")))
         (y (chem-svg-reaction-parity-test--number
             (chem-svg-reaction-parity-test--get text "y")))
         (width (chem-svg-reaction-parity-test--number
                 (chem-svg-reaction-parity-test--get text "width")))
         (height (chem-svg-reaction-parity-test--number
                  (chem-svg-reaction-parity-test--get text "height")))
         (count (length lines))
         (line-height (/ height count)))
    (cl-loop for line in lines
             for index from 0
             collect (chem-reaction-part-create
                      :kind :text
                      :role (if (= count 1)
                                (intern (concat ":" role))
                              (intern (concat ":" role "-line")))
                      :text line
                      :x x
                      :y (- (+ y (* (1+ index) line-height)))
                      :width width
                      :height line-height
                      :scale 1.0))))

(defun chem-svg-reaction-parity-test--build-reaction (fixture options)
  "Build a test-only `chem-reaction' from FIXTURE and OPTIONS.
The layout boxes come from the reference composition; component drawings
come from the reference component graphs."
  ;; The corpus compares composition, so agents are represented by the
  ;; reference condition text.  Agent formula formatting is covered by the
  ;; structural reaction tests, not by this parity builder.
  (let ((component-parts (make-hash-table :test 'eql))
        (reactants nil)
        (products nil)
        (above "")
        (below ""))
    (dolist (component (chem-svg-reaction-parity-test--list
                        (chem-svg-reaction-parity-test--get fixture "components")))
      (let* ((index (chem-svg-reaction-parity-test--number
                     (chem-svg-reaction-parity-test--get component "index")))
             (kind (chem-svg-reaction-parity-test--get component "kind"))
             (drawing (chem-svg-reaction-parity-test--build-drawing component))
             (local (chem-drawing-bounds drawing))
             (viewbox (mapcar #'chem-svg-reaction-parity-test--number
                              (chem-svg-reaction-parity-test--list
                               (chem-svg-reaction-parity-test--get component "viewBox"))))
             (flow (chem-svg-reaction-parity-test--flow-part fixture index))
             (ref-x (chem-svg-reaction-parity-test--number
                     (chem-svg-reaction-parity-test--get flow "x")))
             (ref-y (chem-svg-reaction-parity-test--number
                     (chem-svg-reaction-parity-test--get flow "y")))
             (part (chem-reaction-part-create
                    :kind (if (equal kind "reactant") :reactant :product)
                    :drawing drawing
                    :x (+ (nth 0 local) (- ref-x (nth 0 viewbox)))
                    :y (- (nth 1 local) (- ref-y (nth 1 viewbox)))
                    :width (- (nth 2 local) (nth 0 local))
                    :height (- (nth 3 local) (nth 1 local))
                    :scale 1.0)))
        (puthash index part component-parts)
        (if (equal kind "reactant")
            (push drawing reactants)
          (push drawing products))))
    (let ((parts nil))
      (dolist (flow (chem-svg-reaction-parity-test--list
                     (chem-svg-reaction-parity-test--get fixture "flow")))
        (let ((kind (chem-svg-reaction-parity-test--get flow "kind"))
              (x (chem-svg-reaction-parity-test--number
                  (chem-svg-reaction-parity-test--get flow "x")))
              (y (chem-svg-reaction-parity-test--number
                  (chem-svg-reaction-parity-test--get flow "y")))
              (width (chem-svg-reaction-parity-test--number
                      (chem-svg-reaction-parity-test--get flow "width")))
              (height (chem-svg-reaction-parity-test--number
                       (chem-svg-reaction-parity-test--get flow "height"))))
          (let ((new-parts
                 (pcase kind
                   ((or "reactant" "product")
                    (list
                     (gethash
                      (chem-svg-reaction-parity-test--number
                       (chem-svg-reaction-parity-test--get flow "component"))
                      component-parts)))
                   ("plus"
                    (list (chem-reaction-part-create
                           :kind :plus :text "+"
                           :x x :y (- (+ y height))
                           :width width :height height
                           :scale 1.0)))
                   ("arrow"
                    (list (chem-reaction-part-create
                           :kind :arrow
                           :x x :y (- (+ y height))
                           :width width :height height
                           :scale 1.0)))
                   ("text"
                    (let ((role (chem-svg-reaction-parity-test--get
                                 flow "role"))
                          (content (chem-svg-reaction-parity-test--get
                                    flow "text")))
                      (if (equal role "above")
                          (setq above content)
                        (setq below content))
                      (chem-svg-reaction-parity-test--text-parts flow)))
                   (_ nil))))
            (dolist (part new-parts) (push part parts)))))
      (chem-reaction-create
       :reactants (nreverse reactants)
       :agents nil
       :products (nreverse products)
       :conditions (list :above above :below below)
       :arrow (list :style :forward)
       :layout (nreverse parts)))))

(defun chem-svg-reaction-parity-test--layout-options ()
  "Return layout options in IR units."
  (chem--build-reaction-options
   '(("svg-scale" . 30.0)
     ("reaction-spacing" . 0.3333333333333333)
     ("reaction-arrow-length" . 4.0)
     ("reaction-plus-size" . 0.3)
     ("reaction-condition-width" . 4.0))
   'svg))

(defun chem-svg-reaction-parity-test--fixture-conditions (fixture)
  "Return reaction conditions from FIXTURE."
  (let ((above "")
        (below ""))
    (dolist (part (chem-svg-reaction-parity-test--list
                   (chem-svg-reaction-parity-test--get fixture "flow")))
      (when (equal (chem-svg-reaction-parity-test--get part "kind") "text")
        (if (equal (chem-svg-reaction-parity-test--get part "role") "above")
            (setq above (chem-svg-reaction-parity-test--get part "text"))
          (setq below (chem-svg-reaction-parity-test--get part "text")))))
    (list :above above :below below)))

(defun chem-svg-reaction-parity-test--build-layout-reaction (fixture options)
  "Build FIXTURE's reaction from reference graphs and lay it out with OPTIONS."
  (let ((reactants nil)
        (products nil))
    (dolist (component (chem-svg-reaction-parity-test--list
                        (chem-svg-reaction-parity-test--get fixture "components")))
      (let* ((kind (chem-svg-reaction-parity-test--get component "kind"))
             (drawing (chem-svg-reaction-parity-test--build-drawing
                       component
                       chem-svg-reaction-parity-test--layout-scale)))
        (if (equal kind "reactant")
            (push drawing reactants)
          (push drawing products))))
    (let ((reaction
           (chem-reaction-create
            :reactants (nreverse reactants)
            :agents nil
            :products (nreverse products)
            :conditions (chem-svg-reaction-parity-test--fixture-conditions fixture)
            :arrow (list :style :forward))))
      (chem-reaction-apply-layout reaction options))))

(defun chem-svg-reaction-parity-test--native-flow-parts (parts)
  "Return PARTS without text parts."
  (cl-remove-if (lambda (part)
                  (eq :text (chem-reaction-part-kind part)))
                parts))

(defun chem-svg-reaction-parity-test--reference-flow-parts (fixture)
  "Return FIXTURE's non-text flow parts."
  (cl-remove-if (lambda (part)
                  (equal (chem-svg-reaction-parity-test--get part "kind")
                         "text"))
                (chem-svg-reaction-parity-test--list
                 (chem-svg-reaction-parity-test--get fixture "flow"))))

(defun chem-svg-reaction-parity-test--flow-kind (part)
  "Return the reference flow kind for native PART."
  (pcase (chem-reaction-part-kind part)
    (:reactant "reactant")
    (:product "product")
    (:plus "plus")
    (:arrow "arrow")
    (_ "")))

(defun chem-svg-reaction-parity-test--part-x-px (part)
  "Return native PART's top-left x in SVG units."
  (* chem-svg-reaction-parity-test--layout-scale
     (chem-reaction-part-x part)))

(defun chem-svg-reaction-parity-test--part-y-px (part)
  "Return native PART's top-left y in SVG units."
  (* chem-svg-reaction-parity-test--layout-scale
     (- (+ (chem-reaction-part-y part)
           (chem-reaction-part-height part)))))

(defun chem-svg-reaction-parity-test--part-width-px (part)
  "Return native PART's width in SVG units."
  (* chem-svg-reaction-parity-test--layout-scale
     (chem-reaction-part-width part)))

(defun chem-svg-reaction-parity-test--part-height-px (part)
  "Return native PART's height in SVG units."
  (* chem-svg-reaction-parity-test--layout-scale
     (chem-reaction-part-height part)))

(defun chem-svg-reaction-parity-test--part-center-x-px (part)
  "Return native PART's center x in SVG units."
  (+ (chem-svg-reaction-parity-test--part-x-px part)
     (/ (chem-svg-reaction-parity-test--part-width-px part) 2.0)))

(defun chem-svg-reaction-parity-test--part-center-y-px (part)
  "Return native PART's center y in SVG units."
  (+ (chem-svg-reaction-parity-test--part-y-px part)
     (/ (chem-svg-reaction-parity-test--part-height-px part) 2.0)))

(defun chem-svg-reaction-parity-test--reference-box (part)
  "Return reference flow PART's (X Y WIDTH HEIGHT)."
  (list (chem-svg-reaction-parity-test--number
         (chem-svg-reaction-parity-test--get part "x"))
        (chem-svg-reaction-parity-test--number
         (chem-svg-reaction-parity-test--get part "y"))
        (chem-svg-reaction-parity-test--number
         (chem-svg-reaction-parity-test--get part "width"))
        (chem-svg-reaction-parity-test--number
         (chem-svg-reaction-parity-test--get part "height"))))

(defun chem-svg-reaction-parity-test--native-text-block (part)
  "Return the text block for native PART."
  (pcase (chem-reaction-part-role part)
    ((or :agent-label :above :above-line) :above)
    ((or :below :below-line) :below)
    (_ nil)))

(defun chem-svg-reaction-parity-test--layout-text-lines (reaction block)
  "Return REACTION's layout text lines for BLOCK."
  (cl-loop for part in (chem-reaction-layout reaction)
           when (and (eq :text (chem-reaction-part-kind part))
                     (eq block
                         (chem-svg-reaction-parity-test--native-text-block part)))
           collect (chem-reaction-part-text part)))

(defun chem-svg-reaction-parity-test--reference-text-lines (fixture block)
  "Return FIXTURE's reference text lines for BLOCK."
  (cl-loop for text in (chem-svg-reaction-parity-test--list
                        (chem-svg-reaction-parity-test--get fixture "texts"))
           when (equal (if (eq block :above) "above" "below")
                       (chem-svg-reaction-parity-test--get text "role"))
           append
           (chem-svg-reaction-parity-test--list
            (or (chem-svg-reaction-parity-test--get text "lines")
                (list (chem-svg-reaction-parity-test--get text "text"))))))

(defun chem-svg-reaction-parity-test--check-layout-parity (fixture)
  "Check FIXTURE's native layout against SmilesDrawer's composition rules."
  (let* ((options (chem-svg-reaction-parity-test--layout-options))
         (reaction (chem-svg-reaction-parity-test--build-layout-reaction
                    fixture options))
         (layout (chem-reaction-layout reaction))
         (native-flow (chem-svg-reaction-parity-test--native-flow-parts layout))
         (reference-flow (chem-svg-reaction-parity-test--reference-flow-parts
                          fixture))
         (arrow (cl-find :arrow native-flow
                         :key #'chem-reaction-part-kind))
         (reference-arrow
          (cl-find-if
           (lambda (part)
             (equal "arrow"
                    (chem-svg-reaction-parity-test--get part "kind")))
           reference-flow))
         (native-arrow-center (chem-svg-reaction-parity-test--part-center-y-px
                               arrow))
         (reference-arrow-box
          (chem-svg-reaction-parity-test--reference-box reference-arrow))
         (reference-arrow-center
          (+ (nth 1 reference-arrow-box)
             (/ (nth 3 reference-arrow-box) 2.0))))
    (should (= (length native-flow) (length reference-flow)))
    (cl-loop for part in native-flow
             for reference in reference-flow
             do
             (should (equal (chem-svg-reaction-parity-test--flow-kind part)
                            (chem-svg-reaction-parity-test--get
                             reference "kind"))))
    (cl-loop for previous in native-flow
             for part in (cdr native-flow)
             for reference-previous in reference-flow
             for reference in (cdr reference-flow)
             do
             (let ((native-gap (- (chem-svg-reaction-parity-test--part-x-px part)
                                  (+ (chem-svg-reaction-parity-test--part-x-px
                                      previous)
                                     (chem-svg-reaction-parity-test--part-width-px
                                      previous))))
                   (reference-gap
                    (- (chem-svg-reaction-parity-test--number
                        (chem-svg-reaction-parity-test--get reference "x"))
                       (+ (chem-svg-reaction-parity-test--number
                           (chem-svg-reaction-parity-test--get
                            reference-previous "x"))
                          (chem-svg-reaction-parity-test--number
                           (chem-svg-reaction-parity-test--get
                            reference-previous "width"))))))
               (should (chem-svg-reaction-parity-test--close-p
                        native-gap reference-gap))))
    (cl-loop for part in native-flow
             for reference in reference-flow
             do
             (should (chem-svg-reaction-parity-test--close-p
                      (chem-svg-reaction-parity-test--part-center-y-px part)
                      native-arrow-center))
             (should (chem-svg-reaction-parity-test--close-p
                      (+ (chem-svg-reaction-parity-test--number
                          (chem-svg-reaction-parity-test--get reference "y"))
                         (/ (chem-svg-reaction-parity-test--number
                             (chem-svg-reaction-parity-test--get reference "height"))
                            2.0))
                      reference-arrow-center))
             (pcase (chem-reaction-part-kind part)
               (:plus
                (should (chem-svg-reaction-parity-test--close-p
                         (chem-svg-reaction-parity-test--part-width-px part)
                         (chem-svg-reaction-parity-test--number
                          (chem-svg-reaction-parity-test--get
                           reference "width"))))
                (should (chem-svg-reaction-parity-test--close-p
                         (chem-svg-reaction-parity-test--part-height-px part)
                         (chem-svg-reaction-parity-test--number
                          (chem-svg-reaction-parity-test--get
                           reference "height")))))
               (:arrow
                (should (chem-svg-reaction-parity-test--close-p
                         (chem-svg-reaction-parity-test--part-width-px part)
                         (chem-svg-reaction-parity-test--number
                          (chem-svg-reaction-parity-test--get
                           reference "width")))))
               ((or :reactant :product)
                (let* ((drawing (chem-reaction-part-drawing part))
                       (bounds (chem-drawing-bounds drawing)))
                  (should (chem-svg-reaction-parity-test--close-p
                           (chem-svg-reaction-parity-test--part-width-px part)
                           (* chem-svg-reaction-parity-test--layout-scale
                              (- (nth 2 bounds) (nth 0 bounds)))))
                  (should (chem-svg-reaction-parity-test--close-p
                           (chem-svg-reaction-parity-test--part-height-px part)
                           (* chem-svg-reaction-parity-test--layout-scale
                              (- (nth 3 bounds) (nth 1 bounds)))))))))
    (dolist (part (cl-remove-if-not
                   (lambda (part)
                     (eq :text (chem-reaction-part-kind part)))
                   layout))
      (should (chem-svg-reaction-parity-test--close-p
               (chem-svg-reaction-parity-test--part-center-x-px part)
               (chem-svg-reaction-parity-test--part-center-x-px arrow)))
      (pcase (chem-svg-reaction-parity-test--native-text-block part)
        (:above
         (should (< (chem-svg-reaction-parity-test--part-center-y-px part)
                    native-arrow-center)))
        (:below
         (should (> (chem-svg-reaction-parity-test--part-center-y-px part)
                    native-arrow-center)))))
    (dolist (block '(:above :below))
      (should (equal (chem-svg-reaction-parity-test--layout-text-lines
                      reaction block)
                     (chem-svg-reaction-parity-test--reference-text-lines
                      fixture block))))))

(defun chem-svg-reaction-parity-test--viewbox (svg)
  "Return the root viewBox from SVG."
  (when (string-match "<svg[^>]* viewBox=\"\\([^\"]+\\)\"" svg)
    (mapcar #'string-to-number
            (split-string (match-string 1 svg) " " t))))

(defun chem-svg-reaction-parity-test--component-translations (svg)
  "Return molecule group translations from SVG as (X Y) pairs."
  (let ((start 0)
        (translations nil))
    (while (string-match
            "<g data-reaction-part=\"molecule\" transform=\"translate(\\([^,]+\\),\\([^)]+\\))\">"
            svg start)
      (push (list (string-to-number (match-string 1 svg))
                  (string-to-number (match-string 2 svg)))
            translations)
      (setq start (match-end 0)))
    (nreverse translations)))

(defun chem-svg-reaction-parity-test--part-groups (svg kind)
  "Return the body strings for reaction part groups of KIND in SVG."
  (let ((regex (concat "<g data-reaction-part=\"" (regexp-quote kind) "\">\n"))
        (start 0)
        (groups nil))
    (while (string-match regex svg start)
      (let* ((body-start (match-end 0))
             (body-end (string-match "</g>" svg body-start)))
        (push (substring svg body-start body-end) groups)
        (setq start (+ body-end 4))))
    (nreverse groups)))

(defun chem-svg-reaction-parity-test--line-points (body)
  "Return all line endpoints in BODY as (X . Y) pairs."
  (let ((start 0)
        (points nil))
    (while (string-match
            "<line x1=\"\\([^\"]+\\)\" y1=\"\\([^\"]+\\)\" x2=\"\\([^\"]+\\)\" y2=\"\\([^\"]+\\)\""
            body start)
      (push (cons (string-to-number (match-string 1 body))
                  (string-to-number (match-string 2 body)))
            points)
      (push (cons (string-to-number (match-string 3 body))
                  (string-to-number (match-string 4 body)))
            points)
      (setq start (match-end 0)))
    points))

(defun chem-svg-reaction-parity-test--polygon-points (body)
  "Return all polygon vertices in BODY as (X . Y) pairs."
  (let ((start 0)
        (points nil))
    (while (string-match "<polygon points=\"\\([^\"]+\\)\"" body start)
      (let* ((end (match-end 0))
             (points-attribute (match-string 1 body)))
        (dolist (pair (split-string points-attribute " " t))
          (let ((xy (split-string pair "," t)))
            (when (= (length xy) 2)
              (push (cons (string-to-number (car xy))
                          (string-to-number (cadr xy)))
                    points))))
        (setq start end)))
    points))

(defun chem-svg-reaction-parity-test--box (points)
  "Return (MIN-X MIN-Y MAX-X MAX-Y) for POINTS."
  (when points
    (list (apply #'min (mapcar #'car points))
          (apply #'min (mapcar #'cdr points))
          (apply #'max (mapcar #'car points))
          (apply #'max (mapcar #'cdr points)))))

(defun chem-svg-reaction-parity-test--texts (svg)
  "Return reaction text lines from SVG as (X Y CONTENT) lists."
  (let ((start 0)
        (texts nil))
    (while (string-match "<text data-reaction-part=\"text\"[^>]*>" svg start)
      (let* ((body-start (match-end 0))
             (body-end (string-match "</text>" svg body-start))
             (body (substring svg body-start body-end))
             (line-start 0))
        (while (string-match
                "<tspan x=\"\\([^\"]+\\)\" y=\"\\([^\"]+\\)\">\\([^<]*\\)</tspan>"
                body line-start)
          (push (list (string-to-number (match-string 1 body))
                      (string-to-number (match-string 2 body))
                      (match-string 3 body))
                texts)
          (setq line-start (match-end 0)))
        (setq start (+ body-end (length "</text>")))))
    (nreverse texts)))

(defun chem-svg-reaction-parity-test--close-p (a b)
  "Return non-nil when A and B differ by at most the parity tolerance."
  (<= (abs (- a b)) chem-svg-reaction-parity-test--tolerance))

(defun chem-svg-reaction-parity-test--viewbox-close-p (a b)
  "Return non-nil when viewBox coordinates A and B are close enough."
  (<= (abs (- a b)) chem-svg-reaction-parity-test--viewbox-tolerance))

(defun chem-svg-reaction-parity-test--flow-box (fixture)
  "Return the reference composition box (MIN-X MIN-Y MAX-X MAX-Y).
The root SmilesDrawer viewBox includes trailing spacing; the composition
box only covers the actual components, plus signs, arrow, and text."
  (let ((parts (chem-svg-reaction-parity-test--list
                (chem-svg-reaction-parity-test--get fixture "flow")))
        (min-x nil) (min-y nil) (max-x nil) (max-y nil))
    (dolist (part parts)
      (let ((x (chem-svg-reaction-parity-test--number
                (chem-svg-reaction-parity-test--get part "x")))
            (y (chem-svg-reaction-parity-test--number
                (chem-svg-reaction-parity-test--get part "y")))
            (width (chem-svg-reaction-parity-test--number
                    (chem-svg-reaction-parity-test--get part "width")))
            (height (chem-svg-reaction-parity-test--number
                     (chem-svg-reaction-parity-test--get part "height"))))
        (setq min-x (if min-x (min min-x x) x))
        (setq min-y (if min-y (min min-y y) y))
        (setq max-x (if max-x (max max-x (+ x width)) (+ x width)))
        (setq max-y (if max-y (max max-y (+ y height)) (+ y height)))))
    (list min-x min-y max-x max-y)))

(defun chem-svg-reaction-parity-test--check-composition (fixture svg)
  "Check reaction composition FIXTURE against SVG."
  (let* ((flow (chem-svg-reaction-parity-test--list
                (chem-svg-reaction-parity-test--get fixture "flow")))
         (components (cl-remove-if-not
                      (lambda (part)
                        (member (chem-svg-reaction-parity-test--get part "kind")
                                '("reactant" "product")))
                      flow))
         (component-json (chem-svg-reaction-parity-test--list
                          (chem-svg-reaction-parity-test--get fixture "components")))
         (translations (chem-svg-reaction-parity-test--component-translations svg))
         (pluses (chem-svg-reaction-parity-test--part-groups svg "plus"))
         (arrows (chem-svg-reaction-parity-test--part-groups svg "arrow"))
         (texts (chem-svg-reaction-parity-test--texts svg))
         (reference-texts (chem-svg-reaction-parity-test--list
                           (chem-svg-reaction-parity-test--get fixture "texts")))
         (flow-box (chem-svg-reaction-parity-test--flow-box fixture))
         (native-viewbox (chem-svg-reaction-parity-test--viewbox svg))
         (padding (plist-get (chem-svg-reaction-parity-test--options)
                             :svg-padding)))
    (should (= (length components) (length translations)))
    (cl-loop for part in components
             for translation in translations
             for component = (nth (chem-svg-reaction-parity-test--number
                                   (chem-svg-reaction-parity-test--get part "component"))
                                  component-json)
             do
             (let* ((viewbox (mapcar #'chem-svg-reaction-parity-test--number
                                     (chem-svg-reaction-parity-test--list
                                      (chem-svg-reaction-parity-test--get component "viewBox"))))
                    (expected-x (- (chem-svg-reaction-parity-test--number
                                    (chem-svg-reaction-parity-test--get part "x"))
                                   (nth 0 viewbox)))
                    (expected-y (- (chem-svg-reaction-parity-test--number
                                    (chem-svg-reaction-parity-test--get part "y"))
                                   (nth 1 viewbox))))
               (should (chem-svg-reaction-parity-test--close-p
                        expected-x (nth 0 translation)))
               (should (chem-svg-reaction-parity-test--close-p
                        expected-y (nth 1 translation)))))
    (let ((reference-pluses
           (cl-remove-if-not
            (lambda (part)
              (equal (chem-svg-reaction-parity-test--get part "kind") "plus"))
            flow)))
      (should (= (length reference-pluses) (length pluses)))
      (cl-loop for part in reference-pluses
               for body in pluses
               for box = (chem-svg-reaction-parity-test--box
                          (chem-svg-reaction-parity-test--line-points body))
               do
               (should (chem-svg-reaction-parity-test--close-p
                        (chem-svg-reaction-parity-test--number
                         (chem-svg-reaction-parity-test--get part "x"))
                        (nth 0 box)))
               (should (chem-svg-reaction-parity-test--close-p
                        (chem-svg-reaction-parity-test--number
                         (chem-svg-reaction-parity-test--get part "y"))
                        (nth 1 box)))
               (should (chem-svg-reaction-parity-test--close-p
                        (chem-svg-reaction-parity-test--number
                         (chem-svg-reaction-parity-test--get part "width"))
                        (- (nth 2 box) (nth 0 box))))
               (should (chem-svg-reaction-parity-test--close-p
                        (chem-svg-reaction-parity-test--number
                         (chem-svg-reaction-parity-test--get part "height"))
                        (- (nth 3 box) (nth 1 box))))))
    (let ((reference-arrow
           (cl-find-if
            (lambda (part)
              (equal (chem-svg-reaction-parity-test--get part "kind") "arrow"))
            flow)))
      (should (= 1 (length arrows)))
      (let* ((points (append (chem-svg-reaction-parity-test--line-points
                              (car arrows))
                             (chem-svg-reaction-parity-test--polygon-points
                              (car arrows))))
             (box (chem-svg-reaction-parity-test--box points))
             (x (chem-svg-reaction-parity-test--number
                 (chem-svg-reaction-parity-test--get reference-arrow "x")))
             (y (chem-svg-reaction-parity-test--number
                 (chem-svg-reaction-parity-test--get reference-arrow "y")))
             (width (chem-svg-reaction-parity-test--number
                     (chem-svg-reaction-parity-test--get reference-arrow "width")))
             (height (chem-svg-reaction-parity-test--number
                      (chem-svg-reaction-parity-test--get reference-arrow "height"))))
        (should (chem-svg-reaction-parity-test--close-p x (nth 0 box)))
        (should (chem-svg-reaction-parity-test--close-p (+ x width) (nth 2 box)))
        (should (chem-svg-reaction-parity-test--close-p
                 (+ y (/ height 2.0))
                 (/ (+ (nth 1 box) (nth 3 box)) 2.0)))))
    (let ((reference-lines
           (cl-loop
            for reference in reference-texts
            append
            (let* ((lines (chem-svg-reaction-parity-test--list
                           (or (chem-svg-reaction-parity-test--get
                                reference "lines")
                               (list (chem-svg-reaction-parity-test--get
                                      reference "text")))))
                   (x (chem-svg-reaction-parity-test--number
                       (chem-svg-reaction-parity-test--get reference "x")))
                   (y (chem-svg-reaction-parity-test--number
                       (chem-svg-reaction-parity-test--get reference "y")))
                   (width (chem-svg-reaction-parity-test--number
                           (chem-svg-reaction-parity-test--get reference "width")))
                   (height (chem-svg-reaction-parity-test--number
                            (chem-svg-reaction-parity-test--get reference "height")))
                   (line-height (/ height (length lines))))
              (cl-loop for line in lines
                       for index from 0
                       collect (list line
                                     (+ x (/ width 2.0))
                                     (+ y (* (+ index 0.5) line-height))))))))
      (should (= (length reference-lines) (length texts)))
      (cl-loop for reference in reference-lines
               for text in texts
               do
               (should (equal (chem-exp-svg--escape (nth 0 reference))
                              (nth 2 text)))
               (should (chem-svg-reaction-parity-test--close-p
                        (nth 1 reference) (nth 0 text)))
               (should (chem-svg-reaction-parity-test--close-p
                        (nth 2 reference) (nth 1 text)))))
    (should (= 4 (length native-viewbox)))
    ;; Molecule text bounds can make the native reaction viewBox a superset
    ;; of SmilesDrawer's composition box.  Composition parity requires that
    ;; every reference part is covered, not that the viewBox is minimal.
    (let ((expected-min-x (- (nth 0 flow-box) padding))
          (expected-min-y (- (nth 1 flow-box) padding))
          (expected-max-x (+ (nth 2 flow-box) padding))
          (expected-max-y (+ (nth 3 flow-box) padding))
          (native-min-x (nth 0 native-viewbox))
          (native-min-y (nth 1 native-viewbox))
          (native-max-x (+ (nth 0 native-viewbox) (nth 2 native-viewbox)))
          (native-max-y (+ (nth 1 native-viewbox) (nth 3 native-viewbox))))
      (should (<= native-min-x
                  (+ expected-min-x
                     chem-svg-reaction-parity-test--viewbox-tolerance)))
      (should (<= native-min-y
                  (+ expected-min-y
                     chem-svg-reaction-parity-test--viewbox-tolerance)))
      (should (>= native-max-x
                  (- expected-max-x
                     chem-svg-reaction-parity-test--viewbox-tolerance)))
      (should (>= native-max-y
                  (- expected-max-y
                     chem-svg-reaction-parity-test--viewbox-tolerance))))))

(defun chem-svg-reaction-parity-test--check-fixture (name)
  "Check reaction composition for fixture NAME."
  (let* ((options (chem-svg-reaction-parity-test--options))
         (fixture (chem-svg-reaction-parity-test--load name))
         (reaction (chem-svg-reaction-parity-test--build-reaction
                    fixture options))
         (svg (chem-exp-svg-reaction-render reaction options)))
    (should (stringp svg))
    (chem-svg-reaction-parity-test--check-composition fixture svg)))

(ert-deftest chem-svg-reaction-parity-esterification ()
  "Esterification composition matches SmilesDrawer."
  (chem-svg-reaction-parity-test--check-fixture "esterification"))

(ert-deftest chem-svg-reaction-parity-diels-alder ()
