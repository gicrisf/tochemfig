  (chem-svg-reaction-parity-test--check-fixture "two_products"))

(ert-deftest chem-svg-reaction-parity-stereo ()
  "Stereo and aromatic composition matches SmilesDrawer."
  (chem-svg-reaction-parity-test--check-fixture "stereo"))

(ert-deftest chem-svg-reaction-parity-agent-above ()
