;;; Commentary:

;; Optional Org Babel integration.  This file is the only part of chem-mode
;; that requires Org; core libraries never load it.  Users opt in with
;; `(require 'chem-babel)'.

;;; Code:

(require 'cl-lib)
(require 'subr-x)
(require 'org)
(require 'ob-core)
(require 'org-element)
(require 'chem-mode)
(require 'chem-indigo)
(require 'chem-options)
(require 'chem-export)
(require 'chem-exp-svg)
(require 'chem-exp-chemfig)

(defcustom chem-babel-cache-directory nil
  "Directory for SVG files generated by Org Babel.
When nil, use .chem-cache next to the Org file, or the user cache
directory for unsaved buffers."
  :group 'chem-mode
  :type '(choice (const :tag "Automatic" nil) directory))

(defconst chem-babel-profile-version 1
  "Version of the Org Babel default option profile.")

(defconst chem-babel--reaction-shared-keys
  '(:reaction-arrow :reaction-above :reaction-below
    :reaction-condition-width)
  "Reaction options accepted by both exporters.")

(defconst chem-babel--reaction-svg-keys
  '(:reaction-spacing :reaction-arrow-length :reaction-plus-size)
  "Reaction layout options accepted only by the SVG exporter.")

(defconst chem-babel--reaction-chemfig-keys
  '(:reaction-wrap :reaction-arrow-chemfig)
  "Reaction options accepted only by the chemfig exporter.")

(defconst chem-babel--reaction-forbidden-keys
  '(:wrap-chemfig :chemfig-wrap :submol-name :chemfig-submol)
  "Molecule wrapper options rejected in reaction blocks.")

(defconst chem-babel--chemfig-aliases
  '((:chemfig-terse . "terse")
    (:chemfig-indent . "indent")
    (:chemfig-relative-angles . "relative-angles")
    (:chemfig-wrap . "wrap-chemfig")
    (:chemfig-submol . "submol-name")
    (:chemfig-legacy-lewis . "legacy-lewis"))
  "Org header aliases for chemfig exporter options.")

;;; Default header arguments

(defun chem-babel--install-default-header-args ()
  "Install default Babel header arguments for chem languages."
  (dolist (language '(chem-smiles chem-mol chem-rxn))
    (let ((variable (intern (format "org-babel-default-header-args:%s"
                                    language))))
      (unless (and (boundp variable) (symbol-value variable))
        (set variable
             '((:renderer . "svg")
               (:exports . "results")))))))

(chem-babel--install-default-header-args)

;;; Header parsing

(defun chem-babel--spec-keys (specs)
  "Return the :key values from SPECS."
  (mapcar (lambda (spec) (plist-get spec :key)) specs))

(defun chem-babel--svg-keys ()
  "Return SVG exporter option keys."
  (chem-babel--spec-keys chem-exp-svg-option-specs))

(defun chem-babel--chemfig-keys ()
  "Return chemfig exporter option keys and Org aliases."
  (append (chem-babel--spec-keys chem-exp-chemfig-option-specs)
          (mapcar #'car chem-babel--chemfig-aliases)
          '(:aromatic-circles)))

(defun chem-babel--org-keys ()
  "Return standard Org Babel header keys."
  (append
   (mapcar (lambda (key) (intern (concat ":" (symbol-name key))))
           (mapcar #'car org-babel-common-header-args-w-values))
   '(:result-params :result-type :colname-names :rowname-names)))

(defun chem-babel--accepted-keys ()
  "Return all header keys accepted by chem Babel blocks."
  (delete-dups
   (append (chem-babel--spec-keys chem-common-option-specs)
           (chem-babel--spec-keys chem-reaction-option-specs)
           (chem-babel--svg-keys)
           (chem-babel--chemfig-keys)
           (chem-babel--org-keys)
           '(:renderer :aromatic))))

(defun chem-babel--boolean (value key)
  "Parse VALUE as a boolean for KEY."
  (cond
   ((eq value t) t)
   ((eq value nil) nil)
   ((eq value 1) t)
   ((eq value 0) nil)
   ((and (stringp value)
         (member (downcase value) '("t" "yes" "true" "on" "1")))
    t)
   ((and (stringp value)
         (member (downcase value) '("nil" "no" "false" "off" "0")))
    nil)
   (t (user-error "Invalid boolean for %s: %S" key value))))

(defun chem-babel--number (value key)
  "Parse VALUE as a number for KEY."
  (cond
   ((numberp value) value)
   ((and (stringp value)
         (string-match-p "\\`[-+]?[0-9]+\\(?:\\.[0-9]+\\)?\\'" value))
    (string-to-number value))
   (t (user-error "Invalid number for %s: %S" key value))))

(defun chem-babel--optional-number (value key)
  "Parse VALUE as an optional number for KEY."
  (cond
   ((null value) nil)
   ((and (stringp value) (string-empty-p (string-trim value))) nil)
   (t (chem-babel--number value key))))

(defun chem-babel--choice (value choices key)
  "Parse VALUE as one of CHOICES for KEY."
  (let ((choice (cond
                 ((symbolp value) value)
                 ((stringp value) (intern value))
                 (t (user-error "Invalid choice for %s: %S" key value)))))
    (unless (memq choice choices)
      (user-error "Invalid value for %s: %S (expected %s)"
                  key value (mapconcat #'symbol-name choices ", ")))
    choice))

(defun chem-babel--string (value)
  "Parse VALUE as a non-empty string, or nil."
  (cond
   ((null value) nil)
   ((stringp value) (unless (string-empty-p (string-trim value))
                      (string-trim value)))
   (t (format "%s" value))))

(defun chem-babel--symbol (value key)
  "Parse VALUE as a symbol for KEY."
  (cond
   ((symbolp value) value)
   ((and (stringp value) (not (string-empty-p (string-trim value))))
    (intern (string-trim value)))
   (t (user-error "Invalid symbol for %s: %S" key value))))

(defun chem-babel--positive-integer-p (value)
  "Return non-nil when VALUE is a positive integer."
  (and (integerp value) (> value 0)))

(defun chem-babel--cross-bond (value)
  "Parse VALUE as a list of 1-based atom-number pairs."
  (let ((parsed
         (cond
          ((listp value) value)
          ((stringp value)
           (let ((text (string-trim value)))
             (cond
              ((string-prefix-p "(" text)
               (condition-case nil
                   (car (read-from-string text))
                 (error (user-error "Invalid :cross-bond value: %S" value))))
              (t
               (mapcar
                (lambda (token)
                  (let ((parts (split-string (string-trim token) "-" t)))
                    (unless (and (= 2 (length parts))
                                 (cl-every (lambda (part)
                                             (string-match-p "\\`[0-9]+\\'" part))
                                           parts))
                      (user-error "Invalid :cross-bond pair: %S" token))
                    (mapcar #'string-to-number parts)))
                (split-string text "," t))))))
          (t (user-error "Invalid :cross-bond value: %S" value)))))
    (unless (and (listp parsed)
                 (cl-every (lambda (pair)
                             (and (listp pair)
                                  (= 2 (length pair))
                                  (cl-every #'chem-babel--positive-integer-p
                                            pair)))
                           parsed))
      (user-error "Invalid :cross-bond value: %S" value))
    parsed))

(defun chem-babel--option-spec (key)
  "Return the option spec for KEY."
  (or (cl-find key (append chem-common-option-specs
                           chem-exp-svg-option-specs
                           chem-exp-chemfig-option-specs
                           chem-reaction-option-specs)
               :key (lambda (spec) (plist-get spec :key))
               :test #'eq)
      (user-error "Unknown chem header option: %s" key)))

(defun chem-babel--parse-option (key value)
  "Parse VALUE according to KEY's option spec."
  (let* ((spec (chem-babel--option-spec key))
         (type (plist-get spec :type)))
    (pcase type
      ('boolean (chem-babel--boolean value key))
      ('number (chem-babel--number value key))
      ('optional-number (chem-babel--optional-number value key))
      ('string (chem-babel--string value))
      ('choice (chem-babel--choice value (plist-get spec :choices) key))
      ('cross-bond (chem-babel--cross-bond value))
      ('symbol (chem-babel--symbol value key))
      (_ (chem-babel--string value)))))

(defun chem-babel--target-key (key)
  "Return the exporter option name for header KEY."
  (or (cdr (assq key chem-babel--chemfig-aliases))
      (substring (symbol-name key) 1)))

(defun chem-babel--renderer (params)
  "Return the renderer selected by PARAMS."
  (let* ((value (cdr (assq :renderer params)))
         (renderer (cond
                    ((null value) 'svg)
                    ((symbolp value) value)
                    ((stringp value) (intern value))
                    (t (user-error "Invalid :renderer value: %S" value)))))
    (unless (memq renderer '(svg chemfig))
      (user-error "Unsupported renderer: %s" renderer))
    renderer))

(defun chem-babel--result-file-p (params)
  "Return non-nil when PARAMS request a file result."
  (let ((result-params (cdr (assq :result-params params)))
        (results (cdr (assq :results params))))
    (or (and (listp result-params) (member "file" result-params))
        (and (stringp result-params)
             (string-match-p "\\<file\\>" result-params))
        (and (stringp results)
             (string-match-p "\\<file\\>" results)))))

(defun chem-babel--overrides (params renderer &optional reaction)
  "Return option overrides for PARAMS and RENDERER.
When REACTION is non-nil, accept and validate reaction-specific options."
  (let ((overrides nil)
        (seen nil))
    (dolist (pair params)
      (let ((key (car pair))
            (value (cdr pair)))
        (cond
         ((memq key '(:renderer :aromatic)) nil)
         ((and (not reaction)
               (memq key (append chem-babel--reaction-shared-keys
                                 chem-babel--reaction-svg-keys
                                 chem-babel--reaction-chemfig-keys)))
          (user-error "%s is reaction-only" key))
         ((and reaction (memq key chem-babel--reaction-forbidden-keys))
          (user-error "%s is not supported for reactions" key))
         ((and reaction (memq key chem-babel--reaction-shared-keys))
          (let ((target (chem-babel--target-key key)))
            (push target seen)
            (push (cons target (chem-babel--parse-option key value))
                  overrides)))
         ((and reaction (memq key chem-babel--reaction-svg-keys))
          (when (eq renderer 'chemfig)
            (user-error "%s is SVG-only for reactions" key))
          (let ((target (chem-babel--target-key key)))
            (push target seen)
            (push (cons target (chem-babel--parse-option key value))
                  overrides)))
         ((and reaction (memq key chem-babel--reaction-chemfig-keys))
          (when (eq renderer 'svg)
            (user-error "%s is chemfig-only for reactions" key))
          (let* ((target (chem-babel--target-key key))
                 (spec-key (intern (concat ":" target))))
            (push target seen)
            (push (cons target (chem-babel--parse-option spec-key value))
                  overrides)))
         ((eq key :aromatic-circles)
          (when (eq renderer 'svg)
            (user-error ":aromatic-circles is chemfig-only; use :aromatic or :svg-aromatic"))
          (push "aromatic-circles" seen)
          (push (cons "aromatic-circles"
                      (chem-babel--parse-option key value))
                overrides))
         ((memq key (chem-babel--svg-keys))
          (when (eq renderer 'chemfig)
            (user-error "%s is SVG-only" key))
          (let ((target (chem-babel--target-key key)))
            (push target seen)
            (push (cons target (chem-babel--parse-option key value))
                  overrides)))
         ((memq key (chem-babel--chemfig-keys))
          (when (eq renderer 'svg)
            (user-error "%s is chemfig-only" key))
          (let* ((target (chem-babel--target-key key))
                 (spec-key (intern (concat ":" target))))
            (push target seen)
            (push (cons target (chem-babel--parse-option spec-key value))
                  overrides)))
         ((memq key (chem-babel--org-keys)) nil)
         ((memq key (chem-babel--spec-keys chem-common-option-specs))
          (let ((target (chem-babel--target-key key)))
            (push target seen)
            (push (cons target (chem-babel--parse-option key value))
                  overrides)))
         ((not (memq key (chem-babel--accepted-keys)))
          (user-error "Unknown chem header argument: %s" key)))))
    (let ((aromatic (cdr (assq :aromatic params))))
      (when aromatic
        (let ((value (chem-babel--choice
                      aromatic '(auto circle alternating) :aromatic)))
          (if (eq renderer 'svg)
              (unless (member "svg-aromatic" seen)
                (push (cons "svg-aromatic" value) overrides))
            (unless (member "aromatic-circles" seen)
              (push (cons "aromatic-circles"
                          (pcase value
                            ('circle t)
                            ('alternating nil)
                            ('auto
                             (user-error
                              ":aromatic auto is not supported for chemfig; use circle or alternating"))))
                    overrides))))))
    (let ((overrides (nreverse overrides)))
      (when (and (eq renderer 'svg)
                 (assoc "svg-font-family" overrides)
                 (null (cdr (assoc "svg-font-family" overrides))))
        (user-error ":svg-font-family must not be empty"))
      overrides)))

(defun chem-babel--options (params renderer &optional reaction)
  "Build drawing options from PARAMS for RENDERER.
When REACTION is non-nil, build reaction options."
  (if reaction
      (chem--build-reaction-options
       (chem-babel--overrides params renderer t) renderer t)
    (chem--build-options (chem-babel--overrides params renderer) renderer t)))

;;; Cache

(defun chem-babel--cache-directory ()
  "Return the cache directory for Org-generated SVG files."
  (or chem-babel-cache-directory
      (if buffer-file-name
          (expand-file-name ".chem-cache"
                            (file-name-directory buffer-file-name))
        (expand-file-name "chem-mode"
                          (or (getenv "XDG_CACHE_HOME") "~/.cache")))))

(defun chem-babel--relative-path (path)
  "Return PATH relative to the current Org buffer."
  (let ((base (if buffer-file-name
                  (file-name-directory buffer-file-name)
                default-directory)))
    (file-relative-name path base)))

(defun chem-babel--write-svg (svg)
  "Write SVG to the Babel cache and return its path."
  (chem-mode--write-image svg (chem-babel--cache-directory)))

;;; Execution

(defun chem-babel--execute (body params language)
  "Execute BODY with PARAMS for LANGUAGE."
  (let* ((renderer (chem-babel--renderer params))
         (file-result (chem-babel--result-file-p params)))
    (when (and (eq renderer 'svg) (not file-result))
      (user-error "SVG blocks require :results file"))
    (when (and (eq renderer 'chemfig) file-result)
      (user-error "Chemfig blocks require :results value or raw"))
    (let* ((reaction (eq language 'rxn))
           (options (chem-babel--options params renderer reaction))
           (object
            (pcase language
              ('smiles (chem-from-string body options))
              ('mol (chem-from-mol-string body options))
              ('rxn (chem-from-reaction-string body options))
              (_ (user-error "Unsupported chem Babel language: %s" language))))
           (output (chem-render object renderer options)))
      (if (eq renderer 'svg)
          (chem-babel--relative-path (chem-babel--write-svg output))
        output))))

(defun org-babel-execute:chem-smiles (body params)
  "Execute a chem-smiles BODY with PARAMS."
  (chem-babel--execute body params 'smiles))

(defun org-babel-execute:chem-mol (body params)
  "Execute a chem-mol BODY with PARAMS."
  (chem-babel--execute body params 'mol))

(defun org-babel-execute:chem-rxn (body params)
  "Execute a chem-rxn reaction BODY with PARAMS."
  (chem-babel--execute body params 'rxn))

;;; Commands

(defun chem-org-regenerate-buffer ()
  "Execute all chem-smiles, chem-mol, and chem-rxn blocks."
  (interactive)
  (unless (derived-mode-p 'org-mode)
    (user-error "Not an Org buffer"))
  (let ((org-confirm-babel-evaluate nil)
        (count 0)
        (failures nil))
    (save-excursion
      (org-babel-map-src-blocks nil
        (when (member lang '("chem-smiles" "chem-mol" "chem-rxn"))
          (condition-case err
              (progn
                (org-babel-execute-src-block)
                (setq count (1+ count)))
            (error
             (push (format "line %d: %s"
                           (line-number-at-pos)
                           (error-message-string err))
                   failures))))))
    (message "chem-mode: regenerated %d block(s)" count)
    (when failures
      (user-error "chem-mode: %d block(s) failed:\n%s"
                  (length failures)
                  (mapconcat #'identity (nreverse failures) "\n")))))

(defun chem-babel--referenced-files ()
  "Return absolute SVG paths linked from the current Org buffer."
  (let ((base (if buffer-file-name
                  (file-name-directory buffer-file-name)
                default-directory))
        (paths nil))
    (org-element-map (org-element-parse-buffer) 'link
      (lambda (link)
        (when (equal (org-element-property :type link) "file")
          (let ((path (org-element-property :path link)))
            (when (and path (string-suffix-p ".svg" path))
              (push (file-truename (expand-file-name path base))
                    paths))))))
    paths))

(defun chem-org-clean-cache ()
  "Remove generated SVG files not referenced by links in the current buffer.
The cache is the current buffer's automatic `.chem-cache' directory or
`chem-babel-cache-directory'.  Only files named like generated SVGs are
removed."
  (interactive)
  (unless (derived-mode-p 'org-mode)
    (user-error "Not an Org buffer"))
  (unless buffer-file-name
    (user-error "Save the Org buffer before cleaning its cache"))
  (let* ((directory (chem-babel--cache-directory))
         (referenced (chem-babel--referenced-files))
         (deleted 0))
    (when (file-directory-p directory)
      (dolist (file (directory-files directory t "\\`chem-[0-9a-f]+\\.svg\\'"))
        (unless (member (file-truename file) referenced)
          (condition-case nil
              (progn
                (delete-file file)
                (setq deleted (1+ deleted)))
            (error nil)))))
    (message "chem-mode: removed %d unreferenced SVG file(s)" deleted)))

(provide 'chem-babel)
;;; chem-babel.el ends here
