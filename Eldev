; -*- mode: emacs-lisp; lexical-binding: t -*-

(eldev-use-package-archive 'melpa)

;; The reference mol2chemfigPy3 implementation and its golden output files are
;; used by the parity test suite.  During development a sibling emacs-indigo
;; checkout is preferred, so the pre-built dynamic module is picked up without
;; needing to download and compile it again.  Only when no sibling checkout is
;; available do we fall back to the package from MELPA.
(if (file-directory-p "emacs-indigo")
    (eldev-use-local-sources "emacs-indigo")
  (eldev-add-extra-dependencies 'test '(:package indigo)))

(setf eldev-main-fileset
      '("tochemfig.el"
        "chem-ir.el"
        "tochemfig-transient.el"
        "tochemfig-mode.el"
        "tochemfig-atom.el"
        "tochemfig-bond.el"
        "tochemfig-mappings.el"
        "tochemfig-molecule.el"))

(setf eldev-test-fileset
      '("test/tochemfig-test.el"
        "test/tochemfig-mode-test.el"
        "test/tochemfig-graph-test.el"))
